"""
PINN Training — All Regions, PhysicsNeMo framework.
Master's Thesis: Digital Twin Modeling of Heat Treatment in Cast Metals

Two-phase training:
  Phase A: Data-only pretraining (learn approximate T field)
  Phase B: Physics-informed fine-tuning (enforce PDE + boundary conditions)

Same evaluation as GNN/FNO: Phase 1 (0-3200s) + Phase 2 (3200-4000s).

Usage:
    python train.py
    python train.py --pretrain_epochs 2000 --physics_epochs 3000
"""
from __future__ import annotations

import argparse
import sys
import time
import json
import math
from pathlib import Path

import numpy as np
import torch
import torch.nn.functional as F

sys.path.insert(0, ".")

from configs.pinn_config import PINNConfig, CONFIG
from data.dataset import get_pinn_dataloaders, get_pinn_eval_dataset
from models.pinn_model import HeatTreatmentPINN
from models.physics import compute_pde_residual, compute_boundary_loss
from utils.metrics import compute_metrics, within_tolerance
from utils.checkpoint import CheckpointManager


# ─────────────────────────────────────────────────────────────────────
# Lambda curriculum — SAME as GNN/FNO
# ─────────────────────────────────────────────────────────────────────

def get_lambda_pinn(epoch: int, n_epochs: int) -> float:
    """Smooth exponential — identical to GNN get_lambda_ar()."""
    p = epoch / n_epochs
    lam = 0.001 * math.exp(4.6 * p)
    return min(lam, 0.10)


# ─────────────────────────────────────────────────────────────────────
# Validation
# ─────────────────────────────────────────────────────────────────────

@torch.no_grad()
def validate(model, loader, device):
    """Compute data loss and MAE in Kelvin."""
    model.eval()
    total_loss, n = 0.0, 0
    all_pred, all_true = [], []
    ds = loader.dataset

    for inputs, targets, T_raw in loader:
        inputs, targets = inputs.to(device), targets.to(device)
        pred = model(inputs)
        loss = F.mse_loss(pred, targets)
        total_loss += loss.item()
        n += 1

        T_pred_K = (pred.cpu().numpy().ravel() * ds.T_std + ds.T_mean)
        T_true_K = T_raw.numpy().ravel()
        all_pred.append(T_pred_K)
        all_true.append(T_true_K)

    y_pred = np.concatenate(all_pred)
    y_true = np.concatenate(all_true)
    m = compute_metrics(y_pred, y_true)
    m["loss"] = total_loss / max(n, 1)
    m["within_5K"] = within_tolerance(y_pred, y_true, 5.0)
    m["within_10K"] = within_tolerance(y_pred, y_true, 10.0)
    return m


# ─────────────────────────────────────────────────────────────────────
# Evaluation (Phase 1 + Phase 2, same format as GNN/FNO)
# ─────────────────────────────────────────────────────────────────────

def run_evaluation(model, cfg, device, save_dir):
    """Evaluate on test set — Phase 1 (0-3200s) + Phase 2 (3200-4000s)."""
    model.eval()
    test_ds = get_pinn_eval_dataset(cfg)
    loader = torch.utils.data.DataLoader(
        test_ds, batch_size=cfg.batch_size * 4, shuffle=False, num_workers=0)

    all_pred, all_true, all_t = [], [], []
    ds = test_ds

    with torch.no_grad():
        for inputs, targets, T_raw in loader:
            inputs = inputs.to(device)
            pred = model(inputs)
            T_pred_K = pred.cpu().numpy().ravel() * ds.T_std + ds.T_mean
            T_true_K = T_raw.numpy().ravel()
            t_vals = inputs[:, 3].cpu().numpy() * ds.t_std + ds.t_mean
            all_pred.append(T_pred_K)
            all_true.append(T_true_K)
            all_t.append(t_vals)

    T_pred = np.concatenate(all_pred)
    T_true = np.concatenate(all_true)
    t_all = np.concatenate(all_t)

    # Phase 1: t ≤ 3200s, Phase 2: t > 3200s
    p1_mask = t_all <= cfg.train_time_end
    p2_mask = t_all > cfg.train_time_end

    m1 = compute_metrics(T_pred[p1_mask], T_true[p1_mask]) if p1_mask.sum() > 0 else {}
    m2 = compute_metrics(T_pred[p2_mask], T_true[p2_mask]) if p2_mask.sum() > 0 else {}

    summary = {
        "phase1": {
            "mean_mae": m1.get("mae"),
            "mean_r2": m1.get("r2"),
            "n_points": int(p1_mask.sum()),
        },
        "phase2": {
            "mean_mae": m2.get("mae"),
            "mean_r2": m2.get("r2"),
            "n_points": int(p2_mask.sum()),
        },
    }

    Path(save_dir).mkdir(parents=True, exist_ok=True)
    with open(f"{save_dir}/pinn_evaluation.json", "w") as f:
        json.dump(summary, f, indent=2)

    sep = "=" * 70
    print(f"\n{sep}")
    print(f"  PINN EVALUATION — ALL REGIONS")
    print(f"{sep}")
    p1 = summary["phase1"]
    p2 = summary["phase2"]
    print(f"  Phase 1 (0-{cfg.train_time_end:.0f}s):    "
          f"MAE={p1['mean_mae']:.2f}K  R2={p1['mean_r2']:.4f}  "
          f"({p1['n_points']:,} points)")
    print(f"  Phase 2 ({cfg.train_time_end:.0f}-{cfg.predict_time_end:.0f}s): "
          f"MAE={p2['mean_mae']:.2f}K  R2={p2['mean_r2']:.4f}  "
          f"({p2['n_points']:,} points)")
    print(f"{sep}")
    return summary


# ─────────────────────────────────────────────────────────────────────
# Main training
# ─────────────────────────────────────────────────────────────────────

def main(cfg=None):
    parser = argparse.ArgumentParser(description="Train PhysicsNeMo PINN — All Regions")
    parser.add_argument("--pretrain_epochs", type=int, default=None)
    parser.add_argument("--physics_epochs", type=int, default=None)
    parser.add_argument("--lr", type=float, default=None)
    parser.add_argument("--batch", type=int, default=None)
    parser.add_argument("--device", default=None)
    args = parser.parse_args()

    if cfg is None:
        cfg = CONFIG
    if args.pretrain_epochs: cfg.n_epochs_pretrain = args.pretrain_epochs
    if args.physics_epochs: cfg.n_epochs_physics = args.physics_epochs
    if args.lr: cfg.learning_rate = args.lr
    if args.batch: cfg.batch_size = args.batch

    device = torch.device(
        args.device if args.device
        else ("cuda" if torch.cuda.is_available() else "cpu"))

    sep = "=" * 70
    print(f"\n{sep}")
    print(f"  PINN TRAINING — All Regions (PhysicsNeMo)")
    print(f"  Dataset : {cfg.dataset_path}")
    print(f"  Device  : {device}")
    print(f"  Phase A : {cfg.n_epochs_pretrain} epochs (data-only)")
    print(f"  Phase B : {cfg.n_epochs_physics} epochs (physics-informed)")
    print(f"  PDE     : rho*Cp*dT/dt = kappa*Laplacian(T)")
    print(f"  alpha   : {cfg.alpha_steel:.3e} m^2/s (steel)")
    print(f"{sep}\n")

    # ── Data ──────────────────────────────────────────────────────────
    train_loader, val_loader, test_loader = get_pinn_dataloaders(cfg)
    ds = train_loader.dataset

    # Preload all training data to GPU for maximum GPU utilization
    print(f"  Preloading data to GPU...")
    import gc
    ds = train_loader.dataset
    ds.x_raw = torch.tensor(ds.x_raw, dtype=torch.float32)
    ds.y_raw = torch.tensor(ds.y_raw, dtype=torch.float32)
    ds.z_raw = torch.tensor(ds.z_raw, dtype=torch.float32)
    ds.t_raw = torch.tensor(ds.t_raw, dtype=torch.float32)
    ds.Tset_raw = torch.tensor(ds.Tset_raw, dtype=torch.float32)
    ds.rid_raw = torch.tensor(ds.rid_raw, dtype=torch.float32)
    ds.T_raw = torch.tensor(ds.T_raw, dtype=torch.float32)
    gc.collect()
    print(f"  ✓ Data preloaded")

    print(f"  Normalisation:")
    print(f"    T: mean={ds.T_mean:.1f}K  std={ds.T_std:.1f}K")
    print(f"    t: mean={ds.t_mean:.1f}s   std={ds.t_std:.1f}s")

    # ── Model ─────────────────────────────────────────────────────────
    model = HeatTreatmentPINN(cfg).to(device)
    ckpt_mgr = CheckpointManager(cfg.checkpoint_dir)

    # ══════════════════════════════════════════════════════════════════
    # PHASE A: DATA-ONLY PRETRAINING
    # ══════════════════════════════════════════════════════════════════
    print(f"\n{'='*70}")
    print(f"  PHASE A: DATA-ONLY PRETRAINING ({cfg.n_epochs_pretrain} epochs)")
    print(f"{'='*70}")

    optimizer = torch.optim.Adam(model.parameters(), lr=cfg.lr_pretrain,
                                  weight_decay=cfg.weight_decay)
    scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(
        optimizer, T_max=cfg.n_epochs_pretrain, eta_min=1e-6)

    print(f"  {'Ep':>6} | {'TrLoss':>9} | {'VaLoss':>9} | "
          f"{'MAE[K]':>7} | {'R2':>7} | {'W5K':>6}")
    print(f"  {'-'*60}")

    t0 = time.time()
    for epoch in range(1, cfg.n_epochs_pretrain + 1):
        model.train()
        total_loss, nb = 0.0, 0
        for inputs, targets, _ in train_loader:
            inputs, targets = inputs.to(device), targets.to(device)
            optimizer.zero_grad()
            pred = model(inputs)
            loss = F.mse_loss(pred, targets)
            loss.backward()
            if cfg.grad_clip > 0:
                torch.nn.utils.clip_grad_norm_(model.parameters(), cfg.grad_clip)
            optimizer.step()
            total_loss += loss.item()
            nb += 1
        scheduler.step()

        tr_loss = total_loss / max(nb, 1)
        val_m = validate(model, val_loader, device)
        is_best = ckpt_mgr.update(model, optimizer, scheduler, epoch, val_m)

        if epoch % cfg.log_every == 0 or epoch == 1 or is_best:
            lr = optimizer.param_groups[0]["lr"]
            tag = "  < BEST" if is_best else ""
            print(f"  {epoch:>6} | {tr_loss:>9.5f} | {val_m['loss']:>9.5f} | "
                  f"{val_m['mae']:>7.2f} | {val_m['r2']:>7.4f} | "
                  f"{val_m['within_5K']:>6.1f}{tag}")

    phase_a_time = time.time() - t0
    print(f"\n  Phase A done in {phase_a_time/60:.1f} min")
    print(f"  Best MAE: {ckpt_mgr.best_mae:.3f}K")

    # ══════════════════════════════════════════════════════════════════
    # PHASE B: PHYSICS-INFORMED FINE-TUNING
    # ══════════════════════════════════════════════════════════════════
    print(f"\n{'='*70}")
    print(f"  PHASE B: PHYSICS-INFORMED FINE-TUNING ({cfg.n_epochs_physics} epochs)")
    print(f"  PDE: rho*Cp*dT/dt = kappa*Laplacian(T)")
    print(f"  Lambda curriculum: 0.001 * exp(4.6 * p), cap 0.10")
    print(f"{'='*70}")

    optimizer = torch.optim.Adam(model.parameters(), lr=cfg.lr_physics,
                                  weight_decay=cfg.weight_decay)
    scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(
        optimizer, T_max=cfg.n_epochs_physics, eta_min=1e-6)

    print(f"  {'Ep':>6} | {'TrLoss':>9} | {'VaLoss':>9} | "
          f"{'MAE[K]':>7} | {'R2':>7} | {'Phys':>9} | {'lam':>7}")
    print(f"  {'-'*70}")

    t1 = time.time()
    for epoch in range(1, cfg.n_epochs_physics + 1):
        lam = get_lambda_pinn(epoch, cfg.n_epochs_physics)

        model.train()
        total_loss, total_phys, nb = 0.0, 0.0, 0

        for inputs, targets, _ in train_loader:
            inputs, targets = inputs.to(device), targets.to(device)
            optimizer.zero_grad()

            # Data loss
            pred = model(inputs)
            loss_data = F.mse_loss(pred, targets)

            # Physics loss (PDE residual via autograd)
            loss_phys = torch.tensor(0.0, device=device)
            if lam > 1e-10:
                # Sample a subset for physics (autograd is expensive)
                n_phys = min(2048, inputs.shape[0])
                idx = torch.randperm(inputs.shape[0])[:n_phys]
                phys_inputs = inputs[idx]

                _, residual, _ = compute_pde_residual(
                    model, phys_inputs, cfg, ds)
                loss_phys = residual.pow(2).mean()

            loss = loss_data + lam * loss_phys
            loss.backward()

            if cfg.grad_clip > 0:
                torch.nn.utils.clip_grad_norm_(model.parameters(), cfg.grad_clip)
            optimizer.step()

            total_loss += loss.item()
            total_phys += loss_phys.item()
            nb += 1

        scheduler.step()
        tr_loss = total_loss / max(nb, 1)
        tr_phys = total_phys / max(nb, 1)

        val_m = validate(model, val_loader, device)
        is_best = ckpt_mgr.update(model, optimizer, scheduler,
                                   cfg.n_epochs_pretrain + epoch, val_m)

        if epoch % cfg.save_every == 0:
            ckpt_mgr.save_periodic(model, optimizer, scheduler,
                                    cfg.n_epochs_pretrain + epoch, val_m)

        if epoch % cfg.log_every == 0 or epoch == 1 or is_best:
            tag = "  < BEST" if is_best else ""
            print(f"  {epoch:>6} | {tr_loss:>9.5f} | {val_m['loss']:>9.5f} | "
                  f"{val_m['mae']:>7.2f} | {val_m['r2']:>7.4f} | "
                  f"{tr_phys:>9.3e} | {lam:>7.4f}{tag}")

    phase_b_time = time.time() - t1
    total_time = time.time() - t0
    print(f"\n  Phase B done in {phase_b_time/60:.1f} min")
    print(f"  Total training: {total_time/60:.1f} min")
    print(f"  Best MAE: {ckpt_mgr.best_mae:.3f}K  (epoch {ckpt_mgr.best_epoch})")

    # ── Evaluation ────────────────────────────────────────────────────
    print(f"\n  Loading best model for evaluation...")
    model = HeatTreatmentPINN.load(ckpt_mgr.best_path, cfg, str(device))
    run_evaluation(model, cfg, str(device), f"{cfg.output_dir}/evaluation")


if __name__ == "__main__":
    main()
