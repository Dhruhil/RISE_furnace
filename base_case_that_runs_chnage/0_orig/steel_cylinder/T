FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    0/steel_cylinder;
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [ 0 0 0 1 0 0 0 ];

internalField   uniform 300;

boundaryField
{
    steel_cylinder_to_inner_box
    {
        type            compressible::turbulentTemperatureRadCoupledMixed;
        value           uniform 300;
        Tnbr            T;
        qrNbr           qr;
        qr              none;
        kappaMethod     solidThermo;
    }
    
    steel_cylinder_to_brick_heater
    {
        type            compressible::turbulentTemperatureRadCoupledMixed;
        value           uniform 300;
        Tnbr            T;
        qrNbr           none;
        qr              none;
        kappaMethod     solidThermo;
    }

}


