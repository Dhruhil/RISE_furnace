internalField   uniform 0;

boundaryField
{
    steel_cylinder_to_inner_box
    {
        type            calculated;
        value           uniform 0;
    }
    steel_cylinder_to_brick_heater
    {
        type            calculated;
        value           uniform 0;
    }
}


