FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    0/inner_box/qr;
    object      qr;
}

dimensions      [0 0 0 1 0 0 0];  // Energy per volume per time = W/m³

internalField   uniform 0;

boundaryField

{
    ".*"
    {
         type            greyDiffusiveRadiationViewFactor;
         qro             uniform 0;             // initial guess
         value           uniform 0;
    }
}

