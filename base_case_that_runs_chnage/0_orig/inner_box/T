FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    0/inner_box;
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [ 0 0 0 1 0 0 0 ];

internalField   uniform 300;

boundaryField
{
    
    inner_box_to_steel_cylinder
    {
        type            compressible::turbulentTemperatureRadCoupledMixed;
        value           uniform 300;
        Tnbr            T;
        qrNbr           none;
        qr              qr;
        kappaMethod     fluidThermo;
    }

    inner_box_to_outer_box
    {
        type            compressible::turbulentTemperatureRadCoupledMixed;
        value           uniform 300;
        Tnbr            T;
        qrNbr           none;
        qr              qr;
        kappaMethod     fluidThermo;
    }

    ".*"
    {
        type            compressible::turbulentTemperatureRadCoupledMixed;
        value           uniform 300;
        Tnbr            T;
        qrNbr           none;
        qr              qr;
        kappaMethod     fluidThermo;
    }

}


