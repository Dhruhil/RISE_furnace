FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0/heater_8";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [ 0 0 0 1 0 0 0 ];

internalField   uniform 1000;

boundaryField
{
    heater_8_to_inner_box
    {
        type            compressible::turbulentTemperatureRadCoupledMixed;
        value           uniform 1000;                                      
        Tnbr            T;                                                
        qrNbr           qr;                                             
        qr              none;                                             
        kappaMethod     solidThermo;                                      
    }
    
    heater_8_to_outer_box
    {
        type            compressible::turbulentTemperatureRadCoupledMixed;
        value           uniform 1000;                                      
        Tnbr            T;                                                
        qrNbr           none;                                             
        qr              none;                                             
        kappaMethod     solidThermo;                                      
    }
}


