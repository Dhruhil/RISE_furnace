FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0/inner_box";
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0.1;

boundaryField
{
    inner_box_to_steel_cylinder
    {
        type            calculated;
        value           uniform 0;
    }

    inner_box_to_outer_box
    {
        type            calculated;
        value           uniform 0;
    }
   
    ".*" 
    {
        type            calculated;
        value           uniform 0;
    }
}


