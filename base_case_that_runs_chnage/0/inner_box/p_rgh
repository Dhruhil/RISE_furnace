FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0/inner_box";
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 100000;

boundaryField
{
    ".*"
    {
        type            fixedFluxPressure;
	    gradient        uniform 0;
        value           uniform 100000;
    }
    inner_box_to_steel_cylinder
    {
        type            fixedFluxPressure;
	    gradient        uniform 0;
        value           uniform 100000;
    }
}


