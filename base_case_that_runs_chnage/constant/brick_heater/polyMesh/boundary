        samplePatch     outer_box_to_brick_heater;
    }
    brick_heater_to_inner_box
    {
        type            mappedWall;
        inGroups        1(wall);
        nFaces          107;
        startFace       596;
        sampleMode      nearestPatchFace;
        sampleRegion    inner_box;
        samplePatch     inner_box_to_brick_heater;
    }
    brick_heater_to_steel_cylinder
    {
        type            mappedWall;
        inGroups        1(wall);
        nFaces          77;
        startFace       703;
        sampleMode      nearestPatchFace;
        sampleRegion    steel_cylinder;
        samplePatch     steel_cylinder_to_brick_heater;
    }
)

