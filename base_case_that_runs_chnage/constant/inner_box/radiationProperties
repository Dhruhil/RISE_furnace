FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      radiationProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

radiation       on;

radiationModel  viewFactor;

absorptionEmissionModel none;
scatterModel            none;
sootModel               none;

viewFactorCoeffs
{
    smoothing           true;         // Optional: smooth the view factor matrix
    constantEmissivity  true;         // Emissivity from surfaces is constant
    nBands              1;            // Gray radiation model
    useSolarLoad        false;        // Turn off solar loading
}

// Number of flow iterations per radiation iteration
solverFreq 1;

