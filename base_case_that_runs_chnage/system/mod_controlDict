FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     chtMultiRegionFoam;

startFrom       startTime;//latestTime;

startTime       0.00;

stopAt          endTime;

endTime         50;

deltaT          0.1;

writeControl    adjustable;

writeInterval   1;

purgeWrite      0;

writeFormat     ascii;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable yes;

maxCo           0.5;

// Maximum diffusion number
maxDi           1;

adjustTimeStep  no;

maxDeltaT       1;

functions
{
    writeQr
    {
        type            surfaceFieldValue;
        region          inner_box;
        operation       none;
        fields          (qr);
        writeControl    writeTime;
        writeFields     yes;
    }

    Gfield
    {
        type            volFieldValue;
        region          inner_box;
        operation       none;
        fields          (G);
        writeControl    timeStep;
        writeInterval   1;
    }
}

