FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

PIMPLE
{
    nOuterCorrectors        4;   // <‑‑ the coupling loop
    nCorrectors             2;   // pressure iterations inside each region
    nNonOrthogonalCorrectors 0;
    momentumPredictor       yes;
}

relaxationFactors
{
    equations
    {
        ".*"  0.7;              // mild under‑relaxation is safer than 1
    }
}

