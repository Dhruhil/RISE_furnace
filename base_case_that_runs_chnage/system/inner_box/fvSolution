FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    rho
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-8;
        relTol          0.01;
    }

    rhoFinal
    {
        $rho;
        tolerance       1e-8;
        relTol          0.01;
    }

    p_rgh
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-8;
        relTol          0.01;
    }

    p_rghFinal
    {
        $p_rgh;
        tolerance        1e-8;
        relTol           0.01;
    }

    "(U|h|e|k|epsilon|R)"
    {
        solver           PBiCGStab;
        preconditioner   DILU;
        tolerance        1e-8;
        relTol           0.01;
    }

    "(U|h|e|k|epsilon|R)Final"
    {
        $U;
        tolerance        1e-8;
        relTol           0.01;
    }

}

PIMPLE
{
    momentumPredictor   no;
    nCorrectors         3;
    nNonOrthogonalCorrectors 0;
    pRefPoint        (0.09 0 0);
    pRefValue       1e5;
}

relaxationFactors
{
    equations
    {
        ".*"           1;
    }
}


