FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    system/inner_box;
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    default      Euler;        // Backward for 2‑nd order once things run
}

gradSchemes
{
    default      cellLimited Gauss linear 1;  // 2‑nd order, bounded
}

divSchemes
{
    default                    none;
    div(phi,U)                 Gauss linearUpwind grad(U);
    div(phi,h)                 Gauss linearUpwind grad(h);
    div(phi,K)                 Gauss upwind;            // OK
    div(phi,epsilon)           Gauss upwind;
    div(phi_q,qRad)            Gauss linearUpwind grad(qRad);
    div(((rho*nuEff)*dev2(T(grad(U))))) Gauss linear;     // keep
    div(Ji,Ii_h)               bounded Gauss linearUpwind grad(Ii_h);
}

laplacianSchemes
{
    default                    none;
    laplacian((rho*alphaEff),h)  Gauss linear corrected;
    laplacian((rho*nuEff),U)     Gauss linear corrected;
    laplacian(alphahe,h)         Gauss linear corrected;
    laplacian(rhorAUf,p_rgh)     Gauss linear corrected;
}

interpolationSchemes { default linear; }
snGradSchemes        { default corrected; }

fluxRequired         { p_rgh; }

