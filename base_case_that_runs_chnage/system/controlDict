FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     chtMultiRegionFoam;

startFrom       startTime;//latestTime

startTime       0;

stopAt          endTime;

endTime         4000;

deltaT          1e-5;

writeControl    adjustable;

writeInterval   10;

purgeWrite      0;

writeFormat     ascii;

writePrecision  8;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable yes;

maxCo           0.2;

// Maximum diffusion number
maxDi           0.2;

adjustTimeStep  yes;

maxDeltaT       1;


// ************************************************************************* //
