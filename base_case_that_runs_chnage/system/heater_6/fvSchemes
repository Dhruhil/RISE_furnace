FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system/outer_box";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes      { default Euler; }

gradSchemes     { default cellLimited Gauss linear 1; }

divSchemes      { default none; }        // no convection

laplacianSchemes
{
    default                        none;
    laplacian((rho*C_eff),h)       Gauss linear corrected;   // << key line
    laplacian(alpha,h)             Gauss linear corrected;
}

interpolationSchemes { default linear; }

snGradSchemes        { default corrected; }                 // not “uncorrected”


