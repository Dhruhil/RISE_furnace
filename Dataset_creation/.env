# OpenFOAM Dataset Pipeline Configuration
# Copy to .env and adjust paths

# Base OpenFOAM case directory
BASE_CASE=/home/openfoam/rise_furnace/base_case_that_runs_chnage

# Output directory for generated cases
OUTPUT_DIR=/home/openfoam/rise_furnace/Testing_Create_Dataset

# OpenFOAM container base path (for run scripts)
CONTAINER_BASE_DIR=/home/openfoam/rise_furnace/Testing_Create_Dataset

# Number of LHS samples
N_LHS_SAMPLES=5

# Random seed for reproducibility
LHS_SEED=42