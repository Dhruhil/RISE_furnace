#!/bin/bash
#SBATCH --job-name=heat_fno_FINAL
#SBATCH --account=NAISS2026-4-712
#SBATCH --partition=alvis
#SBATCH --output=/mimer/NOBACKUP/groups/revar/FNO_PhysicsNeMo_Official/outputs/FINAL_RUN_20260419_1412/logs/fno_final_%j.log
#SBATCH --error=/mimer/NOBACKUP/groups/revar/FNO_PhysicsNeMo_Official/outputs/FINAL_RUN_20260419_1412/logs/fno_final_err_%j.log
#SBATCH --time=48:00:00
#SBATCH --gpus-per-node=A40:1
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --cpus-per-task=16

module purge 2>/dev/null
unset PYTHONPATH
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# Set output directory for training
export OUTPUT_DIR="/mimer/NOBACKUP/groups/revar/FNO_PhysicsNeMo_Official/outputs/FINAL_RUN_20260419_1412"

mkdir -p ${OUTPUT_DIR}/logs
mkdir -p ${OUTPUT_DIR}/checkpoints
mkdir -p ${OUTPUT_DIR}/rollout_results
mkdir -p ${OUTPUT_DIR}/plots

cd /mimer/NOBACKUP/groups/revar/FNO_PhysicsNeMo_Official

echo "============================================================"
echo "  FNO v4 — FINAL 100-EPOCH RUN"
echo "  Config: L_conv /100, L_rad /1000, lam=0.003"
echo "  Dataset: v2 (78 cases), LR=1e-4, batch=4"
echo "  GPU: A40"
echo "  Output folder: ${OUTPUT_DIR}"
echo "============================================================"
echo "Start: $(date)"

apptainer exec --nv --cleanenv \
  /mimer/NOBACKUP/groups/revar/physicsnemo_25.06.sif \
  python -u train.py --epochs 100 --lr 1e-4 --batch 4 --lam 0.003 \
    2>&1 | tee ${OUTPUT_DIR}/logs/training_full.log

echo "============================================================"
echo "  DONE: $(date)"
echo "  All outputs in: ${OUTPUT_DIR}"
echo "============================================================"

# Copy important files to final folder
cp -r outputs/checkpoints/* ${OUTPUT_DIR}/checkpoints/ 2>/dev/null
cp train.py ${OUTPUT_DIR}/train.py.used
cp configs/fno_config.py ${OUTPUT_DIR}/fno_config.py.used

echo "Final files preserved in: ${OUTPUT_DIR}"
